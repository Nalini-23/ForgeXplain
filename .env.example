# Copy this file to .env and fill in values as needed.

# ---- Storage backend ------------------------------------------------------
# "local"    -> SQLite, zero setup (default)
# "supabase" -> requires SUPABASE_URL and SUPABASE_KEY below
STORAGE_BACKEND=local

# ---- Supabase (only needed if STORAGE_BACKEND=supabase) -------------------
SUPABASE_URL=
SUPABASE_KEY=

# ---- Auth -------------------------------------------------------------------
SESSION_SECRET=change-this-to-a-long-random-string

# ---- ML ------------------------------------------------------------------------
DEFAULT_MODEL=random_forest

# ---- Active detection engine ---------------------------------------------------
# "features" -> uses the in-app OpenCV + 23-engineered-feature pipeline,
#               trained and evaluated on the real CEDAR dataset (recommended —
#               metrics are computed automatically, never manually typed in)
# "pixel"    -> uses trained_models/pixel_rf_model.joblib + label_encoder.joblib
#               (an externally-trained model with no in-app evaluation numbers;
#               its "Model Performance" page requires you to type metrics in by
#               hand, which is how stale/fake 100% numbers get stuck there)
ACTIVE_ENGINE=features
